generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PARENT
  STAFF
}

enum AbsenceStatus {
  OPEN
  CLAIMED
  EXPIRED
}

model Family {
  id             String     @id @default(uuid())
  email          String     @unique
  name           String
  role           Role       @default(PARENT)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt
  children       Child[]
  absences       Absence[]
  tokens         Token[]
  claims         Claim[]
  staffAuditLogs AuditLog[]
}

model Child {
  id       String    @id @default(uuid())
  name     String
  familyId String
  family   Family    @relation(fields: [familyId], references: [id])
  absences Absence[]
  claims   Claim[]
}

model Absence {
  id        String        @id @default(uuid())
  date      DateTime
  familyId  String
  family    Family        @relation(fields: [familyId], references: [id])
  childId   String
  child     Child         @relation(fields: [childId], references: [id])
  status    AbsenceStatus @default(OPEN)
  createdAt DateTime      @default(now())
  claim     Claim?
}

model Token {
  id             String    @id @default(uuid())
  familyId       String
  family         Family    @relation(fields: [familyId], references: [id])
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  forfeitedAt    DateTime?
  note           String?
  reminderSentAt DateTime?
  updatedAt      DateTime  @default(now()) @updatedAt
  claim          Claim?
}

model Claim {
  id               String   @id @default(uuid())
  absenceId        String   @unique
  absence          Absence  @relation(fields: [absenceId], references: [id])
  claimingFamilyId String
  claimingFamily   Family   @relation(fields: [claimingFamilyId], references: [id])
  claimingChildId  String
  claimingChild    Child    @relation(fields: [claimingChildId], references: [id])
  tokenId          String   @unique
  token            Token    @relation(fields: [tokenId], references: [id])
  claimedAt        DateTime @default(now())
}

// targetType/targetId always identify the Family the action affected (the
// entity every family-detail activity log query needs), even when the
// literal row mutated was a Token or Absence — those specifics go in
// `details` instead, since e.g. a deleted Absence can't be looked up
// afterward to recover which family it belonged to.
model AuditLog {
  id            String   @id @default(uuid())
  staffFamilyId String
  staffFamily   Family   @relation(fields: [staffFamilyId], references: [id])
  action        String
  targetType    String
  targetId      String
  details       String?
  createdAt     DateTime @default(now())
}
